<Window x:Class="Consolify.KeyboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Consolify Keyboard"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        AllowsTransparency="True"
        Background="Transparent">
    <!--
      AllowsTransparency is safe here, unlike on MainWindow: the trouble it causes is that WPF
      hosts a layered window and a hosted WebView2 then receives no mouse or wheel messages. There
      is no WebView2 in here, and the keyboard is driven entirely by the gamepad, so it never needs
      a mouse message at all. What it buys is real rounded corners over a game.

      The keys themselves are built in code from the layout tables: the layout is data, and rebuilding a
      stack of rows is less machinery than binding a two-layer, ragged-width grid.
    -->
    <Border x:Name="Root" Background="#F2141417" CornerRadius="18" Padding="18"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel x:Name="Rows"/>
    </Border>
</Window>
